{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS",
  "mainBinaryName": "ProjectControlCenter",
  "version": "../package.json",
  "identifier": "io.github.totolford.projectcontrolcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ai-town && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXUS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0d0f12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self'; frame-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "NEXUS contributors",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "NEXUS — Multi-Agent Project Control Center",
    "longDescription": "NEXUS runs a Central agent and specialised Claude Code workers on a project folder, with tasks, inter-agent messages, persistent memory, git worktrees and permission control.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ai-town/convex/": "ai-town/convex/",
      "../ai-town/data/": "ai-town/data/",
      "../ai-town/package.json": "ai-town/package.json",
      "../ai-town/package-lock.json": "ai-town/package-lock.json",
      "../ai-town/tsconfig.json": "ai-town/tsconfig.json",
      "../ai-town/nexus-upstream.json": "ai-town/nexus-upstream.json",
      "../ai-town/LICENSE": "ai-town/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "recommends": ["git"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMkY1RTFFMDkwNzc0RTUKUldUbGRBY0pIbDR2d1RyMHpKK05ubmJlb2N2RWRzUW1ZUnoyWElYYlpoRllrR0hMNVlrUnlOYkIK",
      "endpoints": [
        "https://github.com/totolford/project-control-center/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
